[Unit]
Description=Kadr media platform
Documentation=file:///opt/kadr/current/docs
After=network-online.target litestream.service
Wants=network-online.target

[Service]
Type=notify
User=kadr
Group=kadr
SupplementaryGroups=render
WorkingDirectory=/var/lib/kadr
EnvironmentFile=/etc/kadr/env
ExecStartPre=/opt/kadr/current/kadr migrate up
ExecStart=/opt/kadr/current/kadr serve
Restart=always
RestartSec=3
TimeoutStopSec=60
KillMode=mixed

# Resources
MemoryMax=1700M
MemoryHigh=1400M
CPUWeight=80
IOWeight=80
TasksMax=256
LimitNOFILE=65536

# Sandboxing
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/kadr
DeviceAllow=/dev/dri/renderD128 rw
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
